# Copy to .env and adjust
DATABASE_URL=postgresql://unika:unika_dev@localhost:5433/unikalove
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Phase 5: AI via OpenRouter ---
# Get a key at https://openrouter.ai/keys — leave empty to run on the stub AI.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_MS=45000

# --- Phase 5: Payments (Stripe) ---
# Leave empty to keep checkout disabled ("bientôt disponible").
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PREMIUM_PLUS=
APP_URL=http://localhost:3000
