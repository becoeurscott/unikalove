# Copy to .env and adjust
DATABASE_URL=postgresql://unika:unika_dev@localhost:5433/unikalove
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Phase 5: AI via OpenRouter ---
# Get a key at https://openrouter.ai/keys — leave empty to run on the stub AI.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=  (unset: per-feature routing below applies)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_MS=45000

# --- Phase 5: Payments (Stripe) ---
# Leave empty to keep checkout disabled ("bientôt disponible").
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PREMIUM_PLUS=

# --- Moneroo (Mobile Money: Wave, Orange Money, MTN, Moov... + card) ---------
# Sandbox vs live is decided by the KEY, not the URL. Both secrets are required
# before Mobile Money turns on: without the webhook secret we cannot verify
# callbacks, so we refuse to take money.
# Keys:     https://app.moneroo.io/developers/api-keys
# Webhook:  https://app.moneroo.io/developers/webhooks
#           -> point it at <API_URL>/api/v1/payments/webhook/moneroo
MONEROO_SECRET_KEY=
MONEROO_WEBHOOK_SECRET=
MONEROO_BASE_URL=https://api.moneroo.io

# Shared secret for POST /api/v1/payments/internal/sweep (renewal reminders +
# expiry downgrade), called by the scheduled GitHub Actions workflow.
# Generate with: openssl rand -hex 32
INTERNAL_CRON_TOKEN=
APP_URL=http://localhost:3000

# --- Supabase Postgres ---
# DATABASE_URL = pooled (Supavisor, port 6543, append ?pgbouncer=true)
# DIRECT_URL   = direct (port 5432) — used by prisma migrate only
DIRECT_URL=

# --- Per-feature AI model routing (see src/modules/ai/models.ts) ------------
# Defaults route by cost: Haiku for scoring/moderation, Sonnet for short text,
# Opus for the coach. Override any single feature here; OPENROUTER_MODEL still
# works as a blanket override for all of them.
AI_MODEL_COMPATIBILITY=anthropic/claude-haiku-4.5
AI_MODEL_MODERATION=anthropic/claude-haiku-4.5
AI_MODEL_STARTERS=anthropic/claude-sonnet-5
AI_MODEL_REPLIES=anthropic/claude-sonnet-5
AI_MODEL_PROFILE_SUGGESTIONS=anthropic/claude-sonnet-5
AI_MODEL_COACH=anthropic/claude-opus-5
# Max AI calls per user per day (worst-case cost ceiling).
AI_DAILY_BUDGET=25
